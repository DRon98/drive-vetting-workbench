{
  "name": "@dvw/evidence-store-sqlite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/migrations && cp -R src/migrations/. dist/migrations/",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dvw/core": "workspace:*"
  }
}
